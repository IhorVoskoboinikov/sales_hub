# Скопируй в backend/.env для запуска API без Docker: make infra && make run.
# Порты — те же, что POSTGRES_PORT и REDIS_PORT в deploy/compose/.env (по умолчанию 5432 и 6379).
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://saleshub:saleshub@localhost:5432/saleshub
REDIS_URL=redis://localhost:6379/0
# Письма ловит Mailpit из make infra / make up: веб-интерфейс на localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
LOG_LEVEL=INFO
# Пусто — решает профиль (Swagger выключен только в prod).
DOCS_ENABLED=
# Приватный ключ JWT (RS256). Создаётся командой make keys; путь — относительно backend/.
JWT_PRIVATE_KEY_FILE=secrets/jwt_private.pem
# Права (раздел 5): OPA из make infra и папка политик относительно backend/.
OPA_URL=http://localhost:8181
POLICIES_DIR=../policies
