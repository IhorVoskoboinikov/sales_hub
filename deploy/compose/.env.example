# Порты Postgres и Redis на хосте. Compose читает .env рядом с docker-compose.yml сам.
# Поменял порт — поменяй его и в backend/.env (DATABASE_URL, REDIS_URL) для make run.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Telegram-бот пользователей (раздел 16, make bot): токен от @BotFather и имя бота без @.
# Пусто — make up работает, бот не запускается, привязка Telegram отвечает 503.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
